prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=@CMAKE_INSTALL_FULL_LIBDIR@
includedir=@CMAKE_INSTALL_FULL_INCLUDEDIR@

Name: miracle-wm-config
Description: Configuration library for the Miracle WM
Version: @PROJECT_VERSION@
Requires: mircore glib-2.0 yaml-cpp libevdev
Libs: -L${libdir} -lmiracle-wm-c
Cflags: -I${includedir}
