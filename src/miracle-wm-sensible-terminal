#!/bin/sh
#
# This code is released in public domain by Han Boetes <han@mijncomputer.nl>
#
# This script tries to exec a terminal emulator by trying some known terminal
# emulators.
#
# We welcome patches that add distribution-specific mechanisms to find the
# preferred terminal emulator. On Debian, there is the x-terminal-emulator
# symlink for example.
#
# Invariants:
# 1. $TERMINAL must come first
# 2. Distribution-specific mechanisms come next, e.g. x-terminal-emulator
# 3. Terminal emulators with native Wayland support come next.
# 4. X11-only (or legacy) terminal emulators come last, since they require
#    Xwayland.
# 5. No order is guaranteed/desired within each group.
for terminal in \
    "$TERMINAL" \
    x-terminal-emulator \
    ptyxis \
    foot \
    ghostty \
    kitty \
    alacritty \
    wezterm \
    rio \
    kgx \
    gnome-terminal \
    konsole \
    xfce4-terminal \
    tilix \
    terminator \
    mate-terminal \
    qterminal \
    lxterminal \
    terminology \
    contour \
    roxterm \
    hyper \
    terminix \
    termite \
    termit \
    lilyterm \
    guake \
    tilda \
    st \
    urxvt \
    rxvt \
    Eterm \
    aterm \
    uxterm \
    xterm; do
    if command -v "$terminal" > /dev/null 2>&1; then
        exec "$terminal" "$@"
        exit 0
    fi
done

exit 1
